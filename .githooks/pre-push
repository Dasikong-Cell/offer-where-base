#!/bin/sh
# ============================================================================
# pre-push 静态防线
#
# 为什么必须有：服务端用 `tsx` 直跑 `.ts`，**完全不做类型检查** —— 类型错误在运行期
# 毫无异常、冒烟测试全绿，但 `tsc -b`（npm run build）会直接失败。
# 2026-09-19 测评实测踩到：给 jobs 加 quarantine 列时漏改 JobRow 接口，
# 运行时一切正常，构建却长期是坏的，直到一次软件测评才发现。
#
# 为什么还要加 PII 扫描（2026-09-27）：仓库发布前只有这一道门是「会被 git 推送」的
# 位置，而投递类项目的源码天然会带真实简历信息。实测踩到两次：先是简历本人姓名被
# 硬编码进页面注入脚本（随包发给每个收件人），修完又发现「只改了文件名、没洗内容」——
# docs/ 下的转录行原样留在公开仓库里。两次都是**全绿通过**：一次因为打包检查只覆盖
# 「会进包的文件」，一次因为它只查文件名。凡 git 跟踪的东西（含历史）都会被推送、
# 被浏览、被抓取，"不发包" ≠ "不公开"。判定数据放在 gitignore 的 data/ 里，
# 所以这条钩子本身不含它要找的字符串。
#
# 启用：npm run hooks:install   （即 git config core.hooksPath .githooks）
# 跳过：git push --no-verify    （请自行确认风险）
# ============================================================================
set -e

NODE=node
if [ -x "./node/node.exe" ]; then NODE="./node/node.exe"; fi
if ! command -v "$NODE" >/dev/null 2>&1; then
  echo "⚠️  未找到可用 node，跳过 pre-push 检查（不影响推送）"
  exit 0
fi
if [ ! -f node_modules/typescript/bin/tsc ]; then
  echo "⚠️  未安装依赖（node_modules 缺失），跳过 pre-push 检查。先跑 npm install。"
  exit 0
fi

echo "▶ pre-push [1/6] 类型检查（tsc -b，含 server/）..."
if ! "$NODE" node_modules/typescript/bin/tsc -b; then
  echo ""
  echo "❌ 类型检查失败。服务端 tsx 不做类型检查，这里失败 = 构建是坏的，必须修。"
  exit 1
fi

echo "▶ pre-push [2/6] 控制台内联 JS 语法检查..."
if ! "$NODE" node_modules/tsx/dist/cli.mjs scripts/check_console_syntax.ts; then
  echo ""
  echo "❌ public/console.html 内联脚本有语法错误（嵌套模板字面量最容易漏括号）。"
  exit 1
fi

echo "▶ pre-push [3/6] 控制台作用域检查（未声明的标识符）..."
# 为什么单列一步：console.html 是单文件内联脚本，**没有打包器、没有类型检查**，
# 语法检查也只看语法。删掉一个局部变量却漏改一处引用，语法完全合法，
# 只在运行时抛 ReferenceError；抛在 async 函数中间时，前半段已生效、后半段的
# 十几个渲染调用被静默跳过 —— 页面点得动、数字看着对、四道门禁全绿。
# 实测事故：loadDashboard 残留 apps.length，漏斗图/趋势/平台卡整片不渲染。
if ! "$NODE" node_modules/tsx/dist/cli.mjs scripts/check_console_scope.ts; then
  echo ""
  echo "❌ public/console.html 引用了未声明的标识符（详见上方 行号 + 所属函数）。"
  exit 1
fi

echo "▶ pre-push [4/6] 小程序静态自检（页面注册/tabBar/路由/事件绑定/模板变量）..."
# 为什么放在推送前：小程序白屏与「点了没反应」绝大多数是**静态可查**的问题
# （app.json 里写了不存在的页面、wxml 绑的方法没定义、switchTab 指向非 tabBar 页），
# 而这类错误在微信开发者工具里只表现为界面不动，靠肉眼很难定位。
if ! "$NODE" node_modules/tsx/dist/cli.mjs scripts/mp_check.ts; then
  echo ""
  echo "❌ 小程序静态自检失败，见上方 ✗ 项。"
  exit 1
fi

echo "▶ pre-push [5/6] 全仓库 PII 扫描..."
# 文件列表由 shell 喂进去（git ls-files 在 node 里 spawn 会 EBUSY，见 scripts/pii_guard.ts 文件头）。
# core.quotePath=false：否则 CJK 路径会被输出成 "\344\275\277..." 转义，脚本按字面去找必然找不到。
if ! git -c core.quotePath=false ls-files | "$NODE" node_modules/tsx/dist/cli.mjs scripts/pii_guard.ts --stdin; then
  echo ""
  echo "❌ git 跟踪的文件里含 data/.pii_denylist.txt 列出的个人信息。"
  echo "   推送 = 同时写进 gitee/github 的公开历史，改写历史也无法真正收回。"
  echo "   把具体值换成占位符后重试（见 scripts/pii_guard.ts 顶部说明）。"
  exit 1
fi

echo "▶ pre-push [6/6] 推送范围内【历史 blob】的 PII 扫描..."
# 为什么第 5 步不够（2026-10-11 实测定位）：
#   第 5 步的输入是 `git ls-files` = **工作区此刻的文件**。于是「先提交 PII、再提交删除」
#   这样一次 push，tip 是干净的 ⇒ 第 5 步全绿，而 PII 已经永久进入远端历史（git 只增不减）。
#   本仓库已经踩过：公开历史里 38 个 blob / 23 条路径 / 28 个提交含简历本人姓名、手机号、
#   籍贯到区、身高体重、`D:/Desktop/<姓名>简历.pdf`；而 09-27 那 4 次「清理 PII」提交
#   同样只洗了 tip，门禁每次都绿。
# ⇒ 这一步扫的是「本次推送**新引入**的每个 blob」，即"中间那个提交"也逃不掉。
#    正常 push 只会新增极少量 blob，开销可忽略；新分支（remote 全 0）会扫整条历史 —— 那正是首推该做的。
if [ ! -f data/.pii_denylist.txt ]; then
  echo "  （无 data/.pii_denylist.txt，跳过 —— 与第 5 步同姿态）"
else
  # ⚠️ 不用 `mktemp`：本机 rm 装了删除护栏，拒绝带盘符前缀的路径（实测 trap 里的 rm 失败、
  #    临时文件留在盘上）。改用仓库内 gitignored 的 _tools/，固定名覆盖写，无需删除。
  mkdir -p _tools
  HIST_BLOBS="_tools/_pii_history_blobs.txt"
  HIST_FAIL=0
  # pre-push 的 stdin 是 "<local ref> <local sha> <remote ref> <remote sha>"，一行一个 ref
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    # 删除分支：没有新内容
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then continue; fi
    if [ -z "$remote_sha" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      RANGE="$local_sha"                       # 新分支：整条历史都算本次引入
    else
      RANGE="$remote_sha..$local_sha"
    fi
    # 管道每一段都可能因"范围为空/对象缺失"非 0 退出，故统一 || true（set -e 下必须）
    { git rev-list --objects "$RANGE" 2>/dev/null || true; } \
      | cut -d' ' -f1 | sort -u \
      | git cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null \
      | awk '$2=="blob"{print $1}' | sort -u > "$HIST_BLOBS" || true
    if [ -s "$HIST_BLOBS" ]; then
      echo "  · $local_ref（$RANGE）：$(wc -l < "$HIST_BLOBS") 个新 blob"
      if ! git cat-file --batch < "$HIST_BLOBS" \
        | "$NODE" node_modules/tsx/dist/cli.mjs scripts/pii_history_guard.ts --stdin; then
        HIST_FAIL=1
      fi
    else
      echo "  · $local_ref（$RANGE）：无新 blob"
    fi
  done
  if [ "$HIST_FAIL" != "0" ]; then
    echo ""
    echo "❌ 本次推送引入的历史 blob 里含 data/.pii_denylist.txt 列出的个人信息。"
    echo "   注意：仅再提交一次删除**没有用** —— tip 会变干净，但那个 blob 已经在这条 push 里了。"
    echo "   处理方式二选一："
    echo "     a) 把该值换成占位符后 git commit --amend / rebase 压掉那个提交，再 push；"
    echo "     b) 确认可接受后 git push --no-verify（请自行评估，公开仓库无法真正收回）。"
    exit 1
  fi
fi

echo "✅ pre-push 检查通过"
